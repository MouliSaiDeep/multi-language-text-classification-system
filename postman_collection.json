		{
			"name": "Classification Endpoints",
			"item": [
				{
					"name": "Classify - Single Pair (Entailment)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Validate ClassifyResponse Schema\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"predictions\");",
									"    pm.expect(jsonData.predictions).to.be.an(\"array\");",
									"    pm.expect(jsonData.predictions.length).to.eql(1);",
									"    ",
									"    var pred = jsonData.predictions[0];",
									"    pm.expect(pred).to.have.property(\"premise\");",
									"    pm.expect(pred).to.have.property(\"hypothesis\");",
									"    pm.expect(pred).to.have.property(\"label\");",
									"    pm.expect(pred).to.have.property(\"confidence\");",
									"    pm.expect(pred.confidence).to.be.a(\"number\");",
									"    pm.expect([\"entailment\", \"neutral\", \"contradiction\"]).to.include(pred.label);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pairs\": [\n    {\n      \"premise\": \"A soccer player is kicking a ball into the goal.\",\n      \"hypothesis\": \"A player is playing a sport.\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/classify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"classify"
							]
						},
						"description": "Classify a single premise-hypothesis pair to get predicted logic relationship (entailment, neutral, contradiction)."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"pairs\": [\n    {\n      \"premise\": \"A soccer player is kicking a ball into the goal.\",\n      \"hypothesis\": \"A player is playing a sport.\"\n    }\n  ]\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/classify",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"classify"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [],
							"cookie": [],
							"body": "{\n    \"predictions\": [\n        {\n            \"premise\": \"A soccer player is kicking a ball into the goal.\",\n            \"hypothesis\": \"A player is playing a sport.\",\n            \"label\": \"entailment\",\n            \"confidence\": 0.9542\n        }\n    ]\n}"
						}
					]
				},
				{
					"name": "Classify - Multiple Pairs (Multilingual)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Verify Multiple Predictions Returned\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.predictions.length).to.eql(2);",
									"    ",
									"    // Ensure order is preserved",
									"    pm.expect(jsonData.predictions[0].premise).to.include(\"AI\");",
									"    pm.expect(jsonData.predictions[1].premise).to.include(\"maman\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
