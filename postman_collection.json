						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pairs\": [\n    {\n      \"premise\": \"I love pair programming with AI.\",\n      \"hypothesis\": \"I enjoy coding with AI assistants.\"\n    },\n    {\n      \"premise\": \"Et il a dit, maman, je suis à la maison.\",\n      \"hypothesis\": \"Il a appelé sa mère dès que le bus scolaire l'a déposé.\"\n    }\n  ]\n}"
						},
						"url": {
